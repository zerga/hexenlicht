#version 460
#extension GL_GOOGLE_include_directive : require
#extension GL_EXT_ray_query : require
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_buffer_reference_uvec2 : require

#include "hl_shared.h"

layout(local_size_x = 1) in;

layout(buffer_reference, std430) writeonly buffer OutBuffer { uvec4 h[]; };

layout(push_constant) uniform Push
{
	DeviceAddress tlas;
	DeviceAddress out_hits;
	vec4 origin;
	vec4 dir;
} push;

void main()
{
	rayQueryEXT rq;
	uint n = 0u;

	rayQueryInitializeEXT(rq, accelerationStructureEXT(push.tlas), gl_RayFlagsNoOpaqueEXT, 0xff,
			      push.origin.xyz, 0.0, push.dir.xyz, 65536.0);
	while (rayQueryProceedEXT(rq))
	{
		if (n < 32u)
			OutBuffer(push.out_hits).h[1u + n] = uvec4(floatBitsToUint(rayQueryGetIntersectionTEXT(rq, false)),
				uint(rayQueryGetIntersectionInstanceCustomIndexEXT(rq, false)),
				uint(rayQueryGetIntersectionInstanceIdEXT(rq, false)),
				uint(rayQueryGetIntersectionPrimitiveIndexEXT(rq, false)));
		n++;
	}
	OutBuffer(push.out_hits).h[0] = uvec4(n, 0u, 0u, 0u);
}
