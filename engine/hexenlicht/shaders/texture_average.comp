 * WITHOUT ANY WARRANTY; without even the implied warranty of
 * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.
 *
 * See the GNU General Public License for more details.
 */

#version 460
#extension GL_GOOGLE_include_directive : enable
#extension GL_EXT_nonuniform_qualifier : enable
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_buffer_reference_uvec2 : require

#define THREADS 256
layout(local_size_x = THREADS, local_size_y = 1, local_size_z = 1) in;

#define GLOBAL_UBO_DESC_SET_IDX 0
#include "global_ubo.h"

#define GLOBAL_TEXTURES_DESC_SET_IDX 1
#include "global_textures.h"

#include "transfer.glsl"

layout(buffer_reference, std430) writeonly buffer AverageOut { vec4 v[]; };

layout(push_constant) uniform Push
{
	DeviceAddress	out_average;	/* vec4[2]: by the 2.2 power, by the sRGB curve */
	uint		slot;
	uint		no_bias;	/* 5.6: 1 = the plain mean (vk_materials here's albedo) */
	uint		premultiply;	/* 6.2: 1 = times the alpha, the mean alpha in w */
	uint		alpha_slot;	/* 6.2: the alpha's texture, 0 = slot's own */
} push;

shared vec4 sum_power[THREADS];
shared vec3 sum_srgb[THREADS];

void main()
{
	uint	t = gl_LocalInvocationIndex;
	ivec2	size = global_textureSize(push.slot, 0);
	uint	n = uint(max(size.x, 0)) * uint(max(size.y, 0));
	vec4	a = vec4(0.0);
	vec3	b = vec3(0.0);
	float	bias = (push.no_bias != 0u || push.premultiply != 0u) ? 0.0 : EMISSIVE_TRANSFORM_BIAS;

	for (uint i = t; i < n; i += THREADS)
	{
		ivec2	p = ivec2(int(i % uint(size.x)), int(i / uint(size.x)));
		vec4	c = texelFetch(global_texture_descriptors[nonuniformEXT(push.slot)], p, 0);
		float	w = 1.0;

		if (push.premultiply != 0u)
			w = (push.alpha_slot != 0u) ?
			    global_textureLod(push.alpha_slot, (vec2(p) + 0.5) / vec2(size), 0).a : c.a;
		a.rgb += max(color_to_linear(c.rgb, 0u) + vec3(bias), vec3(0.0)) * w;
		a.w += w;
		b += max(color_to_linear(c.rgb, 1u) + vec3(bias), vec3(0.0)) * w;
	}
	sum_power[t] = a;
	sum_srgb[t] = b;
	barrier();
	for (uint s = THREADS / 2u; s > 0u; s >>= 1)
	{
		if (t < s)
		{
			sum_power[t] += sum_power[t + s];
			sum_srgb[t] += sum_srgb[t + s];
		}
		barrier();
	}
	if (t == 0u)
	{
		float	inv = (n > 0u) ? 1.0 / float(n) : 0.0;
		float	alpha = (push.premultiply != 0u) ? sum_power[0].w * inv : 0.0;

		AverageOut(push.out_average).v[0] = vec4(sum_power[0].rgb * inv, alpha);
		AverageOut(push.out_average).v[1] = vec4(sum_srgb[0] * inv, alpha);
	}
}
