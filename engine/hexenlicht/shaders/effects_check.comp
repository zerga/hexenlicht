#version 460
#extension GL_GOOGLE_include_directive : require
#extension GL_EXT_ray_query : require
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_buffer_reference_uvec2 : require

#include "hl_shared.h"

layout(local_size_x = 64) in;

layout(buffer_reference, std430) readonly buffer RayBuffer { EffectsCheckRay r[]; };
layout(buffer_reference, std430) writeonly buffer ResultBuffer { EffectsCheckResult r[]; };

layout(push_constant) uniform Push
{
	EffectsCheckPush data;
} push;

void main()
{
	uint i = gl_GlobalInvocationID.x;

	if (i >= push.data.num_rays)
		return;

	EffectsCheckRay ray = RayBuffer(push.data.rays).r[i];
	EffectsCheckResult res;
	res.t = -1.0;
	res.candidates = 0u;

	/* as the view pass walks them: every candidate, none confirmed */
	rayQueryEXT rq;
	rayQueryInitializeEXT(rq, accelerationStructureEXT(push.data.tlas), gl_RayFlagsNoneEXT, 0xff,
			      push.data.origin.xyz, 0.0, ray.dir, ray.tmax);
	while (rayQueryProceedEXT(rq))
	{
		if (rayQueryGetIntersectionTypeEXT(rq, false) != gl_RayQueryCandidateIntersectionTriangleEXT)
			continue;
		res.candidates++;
		if (uint(rayQueryGetIntersectionInstanceCustomIndexEXT(rq, false)) == ray.custom &&
		    uint(rayQueryGetIntersectionPrimitiveIndexEXT(rq, false)) == ray.primitive)
			res.t = rayQueryGetIntersectionTEXT(rq, false);
	}
	ResultBuffer(push.data.results).r[i] = res;
}
