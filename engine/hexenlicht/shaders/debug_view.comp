#version 460
#extension GL_GOOGLE_include_directive : require

#define KHR_RAY_QUERY
#define GLOBAL_UBO_DESC_SET_IDX 0
#define GLOBAL_TEXTURES_DESC_SET_IDX 1
#define VERTEX_BUFFER_DESC_SET_IDX 2
#define VERTEX_READONLY 1

#include "path_tracer.h"
#include "utils.glsl"
#include "path_tracer_transparency.glsl"
#include "global_textures.h"
#include "vertex_buffer.h"
#include "path_tracer_hit_shaders.h"
#include "projection.glsl"

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(buffer_reference, std430, buffer_reference_align = 4) readonly buffer UintBufferRef { uint d[]; };
#define pvs_table UintBufferRef(global_ubo.pvs).d
#include "pvs.glsl"

// Just global variables in RQ mode.
RayPayloadGeometry ray_payload_geometry;
RayPayloadEffects ray_payload_effects;

vec3
hash_color(uint x)
{
	x = x * 747796405u + 2891336453u;
	x = ((x >> ((x >> 28u) + 4u)) ^ x) * 277803737u;
	x = (x >> 22u) ^ x;
	return vec3((x >> 16) & 0xffu, (x >> 8) & 0xffu, x & 0xffu) / 255.0 * 0.8 + 0.2;
}

/* The particles and sprites along the ray up to t_max, premultiplied:
 * trace_effects_ray's ray query loop without beams and fog. The
 * candidates come in no particular order: update_payload_transparency
 * puts a hit nearer than all before in front of them, any other behind. */
vec4
trace_effects(vec3 origin, vec3 dir, float t_max)
{
	ray_payload_effects.transparency = uvec2(0);
	ray_payload_effects.distances = 0;
	ray_payload_effects.fog1 = uvec4(0);
	ray_payload_effects.fog2 = uvec4(0);

	rayQueryEXT rayQuery;
	rayQueryInitializeEXT(rayQuery, accelerationStructureEXT(global_ubo.effects_tlas), gl_RayFlagsNoneEXT,
			      AS_FLAG_EFFECTS, origin, 0.0, dir, t_max);

	while (rayQueryProceedEXT(rayQuery))
	{
		uint sbtOffset = rayQueryGetIntersectionInstanceShaderBindingTableRecordOffsetEXT(rayQuery, false);
		int primitiveID = rayQueryGetIntersectionPrimitiveIndexEXT(rayQuery, false);
		float hitT = rayQueryGetIntersectionTEXT(rayQuery, false);
		vec2 bary = rayQueryGetIntersectionBarycentricsEXT(rayQuery, false);

		vec4 transparent = vec4(0);
		switch (sbtOffset)
		{
		case SBTO_PARTICLE:
			transparent = pt_logic_particle(primitiveID, bary);
			break;
		case SBTO_SPRITE:
			transparent = pt_logic_sprite(primitiveID, bary, hitT);
			break;
		}

		if (transparent.a > 0)
			update_payload_transparency(ray_payload_effects, transparent, hitT);
	}

	return get_payload_transparency(ray_payload_effects);
}

/* Traces the geometry: trace_geometry_ray's loop, where masked candidates
 * are kept by pt_logic_masked; true if something was hit */
bool
trace_geometry(vec3 origin, vec3 dir, float t_min, int instance_mask)
{
	ray_payload_geometry.barycentric = vec2(0);
	ray_payload_geometry.primitive_id = ~0u;
	ray_payload_geometry.buffer_and_instance_idx = 0;
	ray_payload_geometry.hit_distance = 0;

	rayQueryEXT rayQuery;
	rayQueryInitializeEXT(rayQuery, accelerationStructureEXT(global_ubo.tlas), gl_RayFlagsNoneEXT, instance_mask,
			      origin, t_min, dir, 65536.0);

	while (rayQueryProceedEXT(rayQuery))
	{
		uint sbtOffset = rayQueryGetIntersectionInstanceShaderBindingTableRecordOffsetEXT(rayQuery, false);
		int primitiveID = rayQueryGetIntersectionPrimitiveIndexEXT(rayQuery, false);
		int instanceID = rayQueryGetIntersectionInstanceIdEXT(rayQuery, false);
		int geometryIndex = rayQueryGetIntersectionGeometryIndexEXT(rayQuery, false);
		uint instanceCustomIndex = rayQueryGetIntersectionInstanceCustomIndexEXT(rayQuery, false);
		vec2 bary = rayQueryGetIntersectionBarycentricsEXT(rayQuery, false);

		if (sbtOffset == SBTO_MASKED &&
		    pt_logic_masked(primitiveID, instanceID, geometryIndex, instanceCustomIndex, bary))
			rayQueryConfirmIntersectionEXT(rayQuery);
	}

	if (rayQueryGetIntersectionTypeEXT(rayQuery, true) != gl_RayQueryCommittedIntersectionTriangleEXT)
		return false;

	pt_logic_rchit(ray_payload_geometry,
		rayQueryGetIntersectionPrimitiveIndexEXT(rayQuery, true),
		rayQueryGetIntersectionInstanceIdEXT(rayQuery, true),
		rayQueryGetIntersectionGeometryIndexEXT(rayQuery, true),
		rayQueryGetIntersectionInstanceCustomIndexEXT(rayQuery, true),
		rayQueryGetIntersectionTEXT(rayQuery, true),
		rayQueryGetIntersectionBarycentricsEXT(rayQuery, true));
	return true;
}

/* writes the pixel: what the ray hit (color, at t_max) and, in albedo
 * mode, the effects in front of it over it */
void
store_pixel(ivec2 px, vec3 color, vec3 origin, vec3 dir, float t_max, bool effects_over)
{
	if (effects_over && global_ubo.debug_view == DEBUGVIEW_ALBEDO && global_ubo.effects_tlas != uvec2(0u))
	{
		vec4 effects = trace_effects(origin, dir, t_max);
		color = effects.rgb + (1.0 - effects.a) * color;
	}
	imageStore(IMG_TAA_OUTPUT, px, vec4(color, 1.0));
}

vec3
kind_color(uint material_id)
{
	switch (material_id & MATERIAL_KIND_MASK)
	{
	case MATERIAL_KIND_WATER:	return vec3(0.2, 0.4, 1.0);
	case MATERIAL_KIND_SLIME:	return vec3(0.2, 1.0, 0.2);
	case MATERIAL_KIND_LAVA:	return vec3(1.0, 0.4, 0.0);
	case MATERIAL_KIND_SKY:		return vec3(0.5, 0.8, 1.0);
	case MATERIAL_KIND_TRANSPARENT:	return vec3(0.8, 0.3, 1.0);
	case MATERIAL_KIND_TRANSP_MODEL: return vec3(1.0, 0.5, 0.8);
	default:			return vec3(0.7);
	}
}

void
main()
{
	ivec2 px = ivec2(rt_LaunchID.xy);
	if (px.x >= global_ubo.width || px.y >= global_ubo.height)
		return;

	/* the primary ray, as primary_rays.rgen's get_primary_ray */
	vec2 screen_pos = (vec2(px) + 0.5) / vec2(global_ubo.width, global_ubo.height);
	vec3 view_dir = projection_screen_to_view(screen_pos, 1.0, false);
	vec3 dir = normalize((global_ubo.invV * vec4(view_dir, 0)).xyz);
	vec3 origin = global_ubo.cam_pos.xyz;
	vec3 forward = global_ubo.invV[2].xyz;

	/* The first-person weapon first: GL draws it over everything (its
	 * depth range hack keeps it out of walls), so where a ray meets it, it
	 * is what the pixel shows, with no effects over it (a translucent
	 * weapon will need them behind it, with E6's blending); like GL's,
	 * from its near plane 4 units in front of the eye. Then the rest.
	 * Everything is opaque but cutouts (masked models, a weapon with
	 * them), whose hits are candidates: kept where the mask's alpha is at
	 * least 0.5. */
	bool weapon = trace_geometry(origin, dir, 4.0 / max(dot(dir, forward), 1e-3), AS_FLAG_VIEWER_WEAPON);
	if (!weapon && !trace_geometry(origin, dir, 0.0, 0xff & ~AS_FLAG_VIEWER_WEAPON))
	{
		store_pixel(px, vec3(0.0), origin, dir, 65536.0, true);
		return;
	}

	float t = ray_payload_geometry.hit_distance;
	Triangle tri = load_and_transform_triangle(ray_payload_geometry.buffer_and_instance_idx >> 16,
						   uint(ray_payload_geometry.buffer_and_instance_idx & 0xffff),
						   ray_payload_geometry.primitive_id);
	vec3 bary;
	bary.yz = ray_payload_geometry.barycentric;
	bary.x = 1.0 - bary.y - bary.z;

	/* the world's triangles have no instance, the brush and alias models'
	 * name theirs */
	int model_instance = (tri.instance_index == ~0u) ? -1 : int(tri.instance_index);

	vec3 normal = normalize(tri.normals * bary);
	vec2 tc = tri.tex_coords * bary;
	float facing = abs(dot(normal, dir));

	uint material = tri.material_id;	/* animated, incl. alternate frames */
	MaterialInfo minfo = get_material_info(material);

	/* mip level from a ray cone: the pixel's footprint at the hit against
	 * the triangle's texel density; P[1][1] is 1 / tan(fov_y / 2), negated */
	vec2 tex_size = vec2(global_textureSize(minfo.base_texture, 0));
	float texel_area = abs(determinant(mat2(tri.tex_coords[1] - tri.tex_coords[0], tri.tex_coords[2] - tri.tex_coords[0]))) *
			   tex_size.x * tex_size.y;
	float world_area = length(cross(tri.positions[1] - tri.positions[0], tri.positions[2] - tri.positions[0]));
	float cone_width = t * 2.0 / (abs(global_ubo.P[1][1]) * float(global_ubo.height));
	float lod = 0.5 * log2(max(texel_area, 1e-8) / max(world_area, 1e-8)) + log2(cone_width / max(facing, 0.05));
	vec3 albedo = global_textureLod(minfo.base_texture, tc, max(lod, 0.0)).rgb;

	/* a model's colorshade tint multiplies GL's vertex light (then clamped
	 * to 1); its values reach 10, so show its hue, scaled to at most 1 */
	if (model_instance >= 0)
	{
		vec3 tint = instance_buffer.model_instances[model_instance].tint;
		albedo *= tint / max(max(tint.r, max(tint.g, tint.b)), 1.0);
	}

	float shade = 0.5 + 0.5 * facing;
	vec3 color;
	switch (global_ubo.debug_view)
	{
	case DEBUGVIEW_NORMALS:
		color = normal * 0.5 + 0.5;
		break;
	case DEBUGVIEW_MATERIAL:	/* the weapon's materials cyan, other cutout materials (masked models) yellow */
		color = (((material & MATERIAL_FLAG_WEAPON) != 0u) ? vec3(0.2, 0.9, 1.0) :
			 (minfo.mask_texture != 0u) ? vec3(1.0, 0.9, 0.2) : kind_color(material)) *
			(0.4 + 0.6 * dot(albedo, vec3(0.299, 0.587, 0.114))) * shade;
		break;
	case DEBUGVIEW_INSTANCES:
		color = ((model_instance < 0) ? vec3(0.5) : hash_color(uint(model_instance))) * shade;
		break;
	case DEBUGVIEW_CLUSTERS:
		/* a brush entity's triangles are in its instance's cluster */
		color = ((tri.cluster < 0) ? vec3(0.5) : hash_color(uint(tri.cluster))) * shade;
		if (!pvs_visible(global_ubo.view_cluster, tri.cluster))
			color *= 0.25;	/* not in the camera's PVS */
		break;
	case DEBUGVIEW_MOTION:
	{
		/* how far the point moved since the last frame (the model
		 * triangles carry it per vertex, brush entities have last frame's
		 * transform); gray = still, blue to yellow = up to 4 units */
		float len = length(tri.positions_prev * bary - tri.positions * bary);
		color = (len < 0.001) ? vec3(0.3) : mix(vec3(0.1, 0.2, 1.0), vec3(1.0, 1.0, 0.0), clamp(len / 4.0, 0.0, 1.0));
		color *= shade;
		break;
	}
	default:
		color = albedo;
		break;
	}

	store_pixel(px, color, origin, dir, t, !weapon);
}
