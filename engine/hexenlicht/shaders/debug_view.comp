#version 460
#extension GL_GOOGLE_include_directive : require

#define KHR_RAY_QUERY
#include "path_tracer_rgen.h"	/* its local size, 8 x 8 */

layout(buffer_reference, std430, buffer_reference_align = 4) readonly buffer UintBufferRef { uint d[]; };
#define pvs_table UintBufferRef(global_ubo.pvs).d
#include "pvs.glsl"

vec3
hash_color(uint x)
{
	x = x * 747796405u + 2891336453u;
	x = ((x >> ((x >> 28u) + 4u)) ^ x) * 277803737u;
	x = (x >> 22u) ^ x;
	return vec3((x >> 16) & 0xffu, (x >> 8) & 0xffu, x & 0xffu) / 255.0 * 0.8 + 0.2;
}

vec3
kind_color(uint material_id)
{
	switch (material_id & MATERIAL_KIND_MASK)
	{
	case MATERIAL_KIND_WATER:	return vec3(0.2, 0.4, 1.0);
	case MATERIAL_KIND_SLIME:	return vec3(0.2, 1.0, 0.2);
	case MATERIAL_KIND_LAVA:	return vec3(1.0, 0.4, 0.0);
	case MATERIAL_KIND_SKY:		return vec3(0.5, 0.8, 1.0);
	case MATERIAL_KIND_GLASS:	return vec3(0.6, 1.0, 1.0);
	case MATERIAL_KIND_TRANSPARENT:	return vec3(0.8, 0.3, 1.0);
	case MATERIAL_KIND_TRANSP_MODEL: return vec3(1.0, 0.5, 0.8);
	default:			return vec3(0.7);
	}
}

/* the length of a light list: black none; up to MAX_BRUTEFORCE_SAMPLING
 * (8: every sample weighs all of them) blue to green; then yellow to red
 * at 64 and more */
vec3
light_count_color(uint count)
{
	if (count == 0u)
		return vec3(0.0);
	if (count <= MAX_BRUTEFORCE_SAMPLING)
		return mix(vec3(0.1, 0.2, 1.0), vec3(0.1, 1.0, 0.2), float(count - 1u) / float(MAX_BRUTEFORCE_SAMPLING - 1));
	return mix(vec3(1.0, 1.0, 0.1), vec3(1.0, 0.1, 0.1),
		   clamp(float(count - MAX_BRUTEFORCE_SAMPLING) / float(64 - MAX_BRUTEFORCE_SAMPLING), 0.0, 1.0));
}

vec3
hue_color(float hue)	/* hue in turns, full saturation and value */
{
	return clamp(abs(fract(hue + vec3(0.0, 2.0 / 3.0, 1.0 / 3.0)) * 6.0 - 3.0) - 1.0, 0.0, 1.0);
}

/* where a G-buffer rendered width pixels wide keeps screen pixel p:
 * checkerboard_interleave.comp's get_input_position */
ivec2
flat_position(ivec2 p, int width)
{
	bool is_even_checkerboard = (p.x & 1) == (p.y & 1);
	if (global_ubo.pt_swap_checkerboard != 0)
		is_even_checkerboard = !is_even_checkerboard;
	return ivec2(p.x / 2 + (is_even_checkerboard ? 0 : width / 2), p.y);
}

/* last frame's base color at screen position pos (pixels, bilinear), in
 * last frame's layout */
vec3
prev_base_color(vec2 pos)
{
	vec2 p = pos - 0.5;
	ivec2 p0 = ivec2(floor(p));
	vec2 f = p - vec2(p0);
	int w = global_ubo.prev_width;
	ivec2 size = ivec2(w, global_ubo.prev_height) - 1;
	vec3 c00 = texelFetch(TEX_PT_BASE_COLOR_B, flat_position(clamp(p0, ivec2(0), size), w), 0).rgb;
	vec3 c10 = texelFetch(TEX_PT_BASE_COLOR_B, flat_position(clamp(p0 + ivec2(1, 0), ivec2(0), size), w), 0).rgb;
	vec3 c01 = texelFetch(TEX_PT_BASE_COLOR_B, flat_position(clamp(p0 + ivec2(0, 1), ivec2(0), size), w), 0).rgb;
	vec3 c11 = texelFetch(TEX_PT_BASE_COLOR_B, flat_position(clamp(p0 + ivec2(1, 1), ivec2(0), size), w), 0).rgb;
	return mix(mix(c00, c10, f.x), mix(c01, c11, f.x), f.y);
}

/* Brian Karis' analytic approximation of the split-sum environment BRDF
 * ("Physically Based Shading on Mobile", 2014): the specular albedo DLSS
 * Ray Reconstruction's guide asks for */
vec3
env_brdf_approx(vec3 F0, float roughness, float NoV)
{
	const vec4 c0 = vec4(-1.0, -0.0275, -0.572, 0.022);
	const vec4 c1 = vec4(1.0, 0.0425, 1.04, -0.04);
	vec4 r = roughness * c0 + c1;
	float a004 = min(r.x * r.x, exp2(-9.28 * NoV)) * r.x + r.y;
	vec2 AB = vec2(-1.04, 1.04) * a004 + r.zw;
	return F0 * AB.x + AB.y;
}

void
main()
{
	ivec2 px = ivec2(gl_GlobalInvocationID.xy);
	if (px.x >= global_ubo.taa_output_width || px.y >= global_ubo.taa_output_height)
		return;

	ivec2 ipos = flat_position(px, global_ubo.width);
	uint material = floatBitsToUint(texelFetch(TEX_PT_SHADING_POSITION, ipos, 0).w);
	bool surface = material != 0u;	/* 0: the sky or nothing (an empty surface) */
	vec4 base = texelFetch(TEX_PT_BASE_COLOR_A, ipos, 0);	/* .a: specular factor */
	vec4 transparent = texelFetch(TEX_PT_TRANSPARENT, ipos, 0);	/* premultiplied */
	vec3 dir = texelFetch(TEX_PT_VIEW_DIRECTION, ipos, 0).xyz;
	vec3 normal = decode_normal(texelFetch(TEX_PT_NORMAL_A, ipos, 0).r);
	vec3 geo_normal = decode_normal(texelFetch(TEX_PT_GEO_NORMAL_A, ipos, 0).r);
	float shade = 0.5 + 0.5 * abs(dot(geo_normal, dir));
	vec3 color = vec3(0.0);

	switch (global_ubo.debug_view)
	{
	case DEBUGVIEW_NORMALS:
		if (surface)
			color = normal * 0.5 + 0.5;
		break;
	case DEBUGVIEW_GEO_NORMALS:
		if (surface)
			color = geo_normal * 0.5 + 0.5;
		break;
	case DEBUGVIEW_MATERIAL:	/* the weapon's materials cyan, other cutout materials (masked models) yellow */
		if (surface)
			color = (((material & MATERIAL_FLAG_WEAPON) != 0u) ? vec3(0.2, 0.9, 1.0) :
				 (get_material_info(material).mask_texture != 0u) ? vec3(1.0, 0.9, 0.2) : kind_color(material)) *
				(0.4 + 0.6 * luminance(base.rgb)) * shade;
		break;
	case DEBUGVIEW_INSTANCES:
		if (surface)
		{
			uint instance = texelFetch(TEX_PT_VISBUF_PRIM_A, ipos, 0).x;	/* ~0u: the world */
			color = ((instance == ~0u) ? vec3(0.5) : hash_color(instance)) * shade;
		}
		break;
	case DEBUGVIEW_CLUSTERS:
		if (surface)
		{
			/* a brush entity's triangles are in its instance's cluster */
			uint cluster = texelFetch(TEX_PT_CLUSTER_A, ipos, 0).x;	/* 0xffff: none */
			color = ((cluster == 0xffffu) ? vec3(0.5) : hash_color(cluster)) * shade;
			if (cluster != 0xffffu && !pvs_visible(global_ubo.view_cluster, int(cluster)))
				color *= 0.25;	/* not in the camera's PVS */
		}
		break;
	case DEBUGVIEW_MOTION:
	{
		/* where the point was last frame, in pixels: gray = still, the hue
		 * shows the direction, the brightness the length (full at 16) */
		vec2 motion = texelFetch(TEX_PT_MOTION, ipos, 0).xy * vec2(global_ubo.width, global_ubo.height);
		float len = length(motion);
		color = (len < 0.01) ? vec3(0.3) :
			hue_color(atan(motion.y, motion.x) / (2.0 * M_PI)) * mix(0.25, 1.0, clamp(len / 16.0, 0.0, 1.0));
		break;
	}
	case DEBUGVIEW_MOTION_CHECK:
	{
		/* this frame's base color minus last frame's where the motion
		 * vector points, four times: black where the vectors are right
		 * (except where the point was hidden or its texture changed);
		 * dark blue where it was off the screen */
		vec2 pos = vec2(px) + 0.5 + texelFetch(TEX_PT_MOTION, ipos, 0).xy * vec2(global_ubo.width, global_ubo.height);
		if (any(lessThan(pos, vec2(0.0))) || any(greaterThanEqual(pos, vec2(global_ubo.taa_output_width, global_ubo.taa_output_height))))
			color = vec3(0.0, 0.0, 0.3);
		else
			color = clamp(abs(base.rgb - prev_base_color(pos)) * 4.0, 0.0, 1.0);
		break;
	}
	case DEBUGVIEW_DEPTH:	/* log scale: white at 1 unit, black at 8192 */
		if (surface)
			color = vec3(1.0 - clamp(log2(max(texelFetch(TEX_PT_VIEW_DEPTH_A, ipos, 0).r, 1.0)) / 13.0, 0.0, 1.0));
		break;
	case DEBUGVIEW_ROUGHNESS:
		if (surface)
		{
			vec2 metallic_roughness = texelFetch(TEX_PT_METALLIC_A, ipos, 0).xy;
			color = vec3(metallic_roughness.y, metallic_roughness.x, base.a);
		}
		break;
	case DEBUGVIEW_DIFFUSE_ALBEDO:
	case DEBUGVIEW_SPECULAR_ALBEDO:
		if (surface)
		{
			vec2 metallic_roughness = texelFetch(TEX_PT_METALLIC_A, ipos, 0).xy;
			vec3 albedo, base_reflectivity;
			get_reflectivity(base.rgb, metallic_roughness.x, albedo, base_reflectivity);
			color = (global_ubo.debug_view == DEBUGVIEW_DIFFUSE_ALBEDO) ? albedo :
				env_brdf_approx(base_reflectivity, metallic_roughness.y, clamp(-dot(normal, dir), 0.0, 1.0)) * base.a;
		}
		break;
	case DEBUGVIEW_EFFECTS:
		color = transparent.rgb;
		break;
	case DEBUGVIEW_BLUE_NOISE:
		rng_seed = texelFetch(TEX_ASVGF_RNG_SEED_A, ipos, 0).r;
		color = vec3(get_rng(0));
		break;
	case DEBUGVIEW_LIT:
		/* the interleaved lit image (checkerboard_interleave.comp), stored
		 * scaled by STORAGE_SCALE_HDR; no exposure or tone curve until 3.7 */
		color = texelFetch(TEX_FLAT_COLOR, px, 0).rgb / STORAGE_SCALE_HDR;
		break;
	case DEBUGVIEW_DIRECT_DIFFUSE:	/* without the albedo, as the denoiser gets it */
		color = unpackRGBE(texelFetch(TEX_PT_COLOR_HF, ipos, 0).r) / STORAGE_SCALE_HF;
		break;
	case DEBUGVIEW_DIRECT_SPECULAR:
		color = unpackRGBE(texelFetch(TEX_PT_COLOR_SPEC, ipos, 0).r) / STORAGE_SCALE_SPEC;
		break;
	case DEBUGVIEW_INDIRECT_DIFFUSE:	/* without the albedo, as the denoiser gets it */
		color = texelFetch(TEX_PT_COLOR_LF_SH, ipos, 0).rgb / STORAGE_SCALE_LF;
		break;
	case DEBUGVIEW_SPECULAR_HIT_DIST:	/* log scale as the depth; black: no specular ray (a diffuse bounce, no
					 * surface, lava, the rows 0.5 skips this frame, no bounces) */
	{
		float d = texelFetch(TEX_PT_SPECULAR_HIT_DIST, ipos, 0).r;
		if (d > 0.0)
			color = vec3(1.0 - clamp(log2(max(d, 1.0)) / 13.0, 0.0, 1.0)) * vec3(1.0, 0.8, 0.5);
		break;
	}
	case DEBUGVIEW_LIGHT_LISTS:	/* what direct_lighting.rgen samples from (light_lists.h) */
		if (surface)
		{
			uint cluster = texelFetch(TEX_PT_CLUSTER_A, ipos, 0).x;	/* 0xffff: none */
			uint count = 0u;
			if (cluster != 0xffffu && cluster + 1u < MAX_LIGHT_LISTS && global_ubo.lights != uvec2(0u))
				count = light_buffer.light_list_offsets[cluster + 1u] - light_buffer.light_list_offsets[cluster];
			color = light_count_color(count) * shade;
		}
		break;
	default:	/* the base color, with the effects (and emission) over it */
		color = transparent.rgb + (1.0 - transparent.a) * base.rgb;
		break;
	}

	imageStore(IMG_TAA_OUTPUT, px, vec4(color, 1.0));
}
