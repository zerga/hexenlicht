#version 460
#extension GL_GOOGLE_include_directive : require
#extension GL_EXT_ray_query : require
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require

#include "hl_shared.h"

layout(local_size_x = 64) in;

struct RayResult
{
	float t;		/* < 0: no hit */
	uint instance;		/* TLAS instance */
	uint primitive;
	uint custom;		/* the instance's custom index */
};

layout(buffer_reference, std430) writeonly buffer ResultBuffer { RayResult r[]; };

layout(push_constant) uniform Push
{
	uint64_t tlas;
	ResultBuffer results;
	vec4 origin;
	vec4 forward;
	vec4 right;
	vec4 up;
	vec2 tan_half_fov;
	uvec2 grid;
	uint cull_mask;
	float tmax;
} push;

void main()
{
	uint i = gl_GlobalInvocationID.x;

	if (i >= push.grid.x * push.grid.y)
		return;

	/* the same directions as vk_accel.c's RayDirection */
	vec2 uv = (vec2(i % push.grid.x, i / push.grid.x) + 0.5) / vec2(push.grid) * 2.0 - 1.0;
	vec3 dir = normalize(push.forward.xyz + push.right.xyz * uv.x * push.tan_half_fov.x
			     - push.up.xyz * uv.y * push.tan_half_fov.y);

	/* every hit is a candidate, so the alias models (which have no
	 * collision hulls to compare with) can be passed through */
	rayQueryEXT rq;
	rayQueryInitializeEXT(rq, accelerationStructureEXT(push.tlas), gl_RayFlagsNoOpaqueEXT,
			      push.cull_mask, push.origin.xyz, 0.0, dir, push.tmax);
	while (rayQueryProceedEXT(rq))
	{
		if (rayQueryGetIntersectionTypeEXT(rq, false) == gl_RayQueryCandidateIntersectionTriangleEXT &&
		    uint(rayQueryGetIntersectionInstanceCustomIndexEXT(rq, false)) != VERTEX_BUFFER_INSTANCED)
			rayQueryConfirmIntersectionEXT(rq);
	}

	RayResult res;
	if (rayQueryGetIntersectionTypeEXT(rq, true) == gl_RayQueryCommittedIntersectionTriangleEXT)
	{
		res.t = rayQueryGetIntersectionTEXT(rq, true);
		res.instance = uint(rayQueryGetIntersectionInstanceIdEXT(rq, true));
		res.primitive = uint(rayQueryGetIntersectionPrimitiveIndexEXT(rq, true));
		res.custom = uint(rayQueryGetIntersectionInstanceCustomIndexEXT(rq, true));
	}
	else
	{
		res.t = -1.0;
		res.instance = 0xffffffffu;
		res.primitive = 0u;
		res.custom = 0u;
	}
	push.results.r[i] = res;
}
